// Scans src/content/<category>/<id>/ and writes import registries to
// src/content/_generated/. Run automatically by dev/build/test/typecheck.
import { readdirSync, existsSync, mkdirSync, writeFileSync, statSync } from "node:fs";
import { join } from "node:path";

const root = join(import.meta.dirname, "..", "src", "content");
const out = join(root, "_generated");

type Found = { category: string; id: string; render?: string; body: boolean };
const found: Found[] = [];

for (const category of readdirSync(root).sort()) {
  const dir = join(root, category);
  if (category.startsWith("_") || !statSync(dir).isDirectory()) continue;
  for (const id of readdirSync(dir).sort()) {
    const f = join(dir, id);
    if (!statSync(f).isDirectory() || !existsSync(join(f, "entry.ts"))) continue;
    const render = ["render.ts", "render.tsx"].find((r) => existsSync(join(f, r)));
    found.push({ category, id, render, body: existsSync(join(f, "body.mdx")) });
  }
}

const header = "// GENERATED by scripts/gen-content.mts. Do not edit.\n";
const q = JSON.stringify;

const entries =
  header +
  found.map((e, i) => `import e${i} from "../${e.category}/${e.id}/entry";`).join("\n") +
  `\n\nexport const generated = [\n` +
  found.map((e, i) => `  { folder: ${q(e.id)}, dir: ${q(e.category)}, entry: e${i} },`).join("\n") +
  `\n];\n`;

const renders =
  header +
  `// Client-only render modules, loaded on demand.\nexport const renders: Record<string, () => Promise<unknown>> = {\n` +
  found
    .filter((e) => e.render)
    .map((e) => `  ${q(e.id)}: () => import("../${e.category}/${e.id}/render"),`)
    .join("\n") +
  `\n};\n`;

const bodies =
  header +
  `import type { MDXContent } from "mdx/types";\n\nexport const bodies: Record<string, () => Promise<{ default: MDXContent }>> = {\n` +
  found
    .filter((e) => e.body)
    .map((e) => `  ${q(e.id)}: () => import("../${e.category}/${e.id}/body.mdx"),`)
    .join("\n") +
  `\n};\n`;

mkdirSync(out, { recursive: true });
writeFileSync(join(out, "entries.ts"), entries);
writeFileSync(join(out, "renders.ts"), renders);
writeFileSync(join(out, "bodies.ts"), bodies);
console.log(`gen-content: ${found.length} entries`);
